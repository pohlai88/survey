# Optional when the backend is not served from the same origin.
VITE_PORTAL_API_BASE_URL=

# Development/test escape hatches. Keep false/empty for production unless an ADR approves a bridge.
VITE_ENABLE_PORTAL_BACKEND_BRIDGE=
VITE_ENABLE_RETOOL_BRIDGE=

# Required before production admin operations can pass the boundary guard.
PORTAL_ADMIN_API_TOKEN=

# Required before resource-backed API operations can execute.
DATABASE_URL=

# Required before invitation or workflow notification operations can execute.
PORTAL_NOTIFICATION_PROVIDER=
PORTAL_NOTIFICATION_FROM=

# Required before evidence upload/download operations can execute.
PORTAL_STORAGE_BUCKET=
PORTAL_API_OBSERVABILITY=
